{
	"productName": "Cold Brew",
	"version": "0.2.0",
	"identifier": "com.coldbrew.app",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "bun run dev",
		"beforeBuildCommand": "bun run build"
	},
	"app": {
		"windows": [
			{
				"title": "Cold Brew",
				"width": 1200,
				"height": 760,
				"minWidth": 800,
				"minHeight": 500,
				"resizable": true,
				"fullscreen": false,
				"decorations": true,
				"transparent": false,
				"alwaysOnTop": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
